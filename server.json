  "version": "1.0.2",
  "websiteUrl": "https://catalog.agentage.io",
  "icons": [
    {
      "src": "https://catalog.agentage.io/mcp/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://catalog.agentage.io/mcp/apple-icon.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    },
    {
      "src": "https://catalog.agentage.io/mcp/icon.png",
      "mimeType": "image/png",
      "sizes": ["48x48"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@agentage/find-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://catalog.agentage.io/mcp"
    }
  ]
